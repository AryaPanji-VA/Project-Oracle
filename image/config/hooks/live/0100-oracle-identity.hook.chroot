#!/bin/sh
# ============================================================================
# image/config/hooks/live/0100-oracle-identity.hook.chroot
#
# Dijalankan DI DALAM chroot image saat build — bukan di host.
#
# Sumber identitas: /etc/oracle/oracle.conf, yang disalin ke dalam image oleh
# scripts/build.sh. Hook TIDAK boleh bergantung pada variabel lingkungan host
# (ORACLE_ROOT dkk): chroot tidak mewarisinya, dan `set -eu` akan menghentikan
# build dengan error yang membingungkan.
#
# Aturan hook: idempotent, tanpa jaringan, gagal keras kalau ada yang salah.
# ============================================================================

set -eu

IDENTITY_SRC="/etc/oracle/oracle.conf"

if [ ! -f "${IDENTITY_SRC}" ]; then
	echo "[oracle] FATAL: ${IDENTITY_SRC} tidak ada." >&2
	echo "[oracle] scripts/build.sh harus menyalinnya ke config/includes.chroot/etc/oracle/." >&2
	exit 1
fi

# shellcheck disable=SC1090
. "${IDENTITY_SRC}"

: "${NAME:?NAME kosong di ${IDENTITY_SRC}}"
: "${ID:?ID kosong di ${IDENTITY_SRC}}"
: "${VERSION:?VERSION kosong di ${IDENTITY_SRC}}"

# --- Hostname ---------------------------------------------------------------
printf '%s\n' "${ID}" > /etc/hostname

# Ganti baris, jangan append: hook yang jalan dua kali tidak boleh menduplikasi.
# Isi standar /etc/hosts hanya 'localhost', jadi penggantian ini tidak
# menghapus entri penting.
if grep -qE '^127\.0\.1\.1[[:space:]]' /etc/hosts 2>/dev/null; then
	sed -i -E "s|^127\.0\.1\.1[[:space:]].*|127.0.1.1\t${ID}|" /etc/hosts
else
	printf '127.0.1.1\t%s\n' "${ID}" >> /etc/hosts
fi

# --- Identitas distribusi (dibaca oleh /etc/os-release) ---------------------
if [ -f /etc/os-release ]; then
	sed -i "s|^PRETTY_NAME=.*|PRETTY_NAME=\"${NAME} ${VERSION}\"|" /etc/os-release
	sed -i "s|^NAME=.*|NAME=\"${NAME}\"|" /etc/os-release
	sed -i "s|^ID=.*|ID=\"${ID}\"|" /etc/os-release
	sed -i "s|^VERSION=.*|VERSION=\"${VERSION}\"|" /etc/os-release
	sed -i "s|^VERSION_ID=.*|VERSION_ID=\"${VERSION}\"|" /etc/os-release
fi

# Penanda build, dipakai saat verifikasi di QEMU.
printf '%s %s (%s %s)\n' "${NAME}" "${VERSION}" "${BASE}" "${DEBIAN_CODENAME}" \
	> /etc/oracle-release

echo "[oracle] identity applied: ${NAME} ${VERSION} / hostname=${ID}"