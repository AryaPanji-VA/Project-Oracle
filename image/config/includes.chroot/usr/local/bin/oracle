#!/bin/sh
# ============================================================================
# image/config/includes.chroot/usr/local/bin/oracle — CLI ORACLE OS
#
# ALAT RUNTIME SAJA. Berkas ini dipasang ke image dan dipakai setelah sistem
# boot, bukan saat build.
#
# Pembagian tugas yang jelas:
#   - build-time  : scripts/gen-profile-list.sh (di host) membaca profile dan
#                   menghasilkan package-list untuk live-build. CLI ini TIDAK
#                   dipanggil saat build.
#   - runtime     : berkas ini. Melihat identitas, melihat/memeriksa profile,
#                   dan memasang profile lewat apt-get.
#
# Keduanya membaca file profile yang SAMA
# (usr/share/oracle/profiles/<nama>.list), sehingga aturan validasinya harus
# identik. Kalau salah satu diubah, ubah keduanya.
#
# Prinsip keamanan:
#   - Nama profile divalidasi terhadap daftar file yang ADA. Input user tidak
#     pernah dieksekusi sebagai shell command, tidak pernah masuk ke `eval`,
#     dan tidak pernah digabung ke string perintah.
#   - Nama paket divalidasi SEBELUM apt-get dipanggil.
#   - Pemasangan runtime wajib lewat sudo dan tidak melanjutkan kalau apt gagal.
#
# Sengaja ditulis POSIX sh: image belum tentu punya bash.
# ============================================================================

set -eu

CONF="${ORACLE_CONF:-/etc/oracle/oracle.conf}"
PROFILE_DIR="${ORACLE_PROFILE_DIR:-/usr/share/oracle/profiles}"
# Override di atas ada supaya logika bisa diuji di host tanpa menyentuh /etc
# dan /usr/share. Di dalam image, keduanya memakai nilai default.

say()  { printf '%s\n' "$*"; }
err()  { printf 'oracle: %s\n' "$*" >&2; }
die()  { err "$*"; exit 1; }

usage() {
	cat <<'EOF'
ORACLE OS — command line interface

Pemakaian:
  oracle identity              tampilkan identitas sistem
  oracle version               tampilkan versi
  oracle profile list          daftar profile yang tersedia
  oracle profile check NAME    cek isi profile tanpa memasang
  oracle profile install NAME  pasang paket profile (butuh administrator)

Profile adalah daftar paket untuk satu tujuan, mis. networking atau
web-security. Profile yang sama dipakai saat build image dan saat runtime.
EOF
}

# ---------------------------------------------------------------------------
# Identitas
# ---------------------------------------------------------------------------
cmd_identity() {
	[ -f "$CONF" ] || die "$CONF tidak ditemukan; image ini tidak lengkap"
	# shellcheck disable=SC1090
	. "$CONF"
	say "NAME            : ${NAME:-?}"
	say "ID              : ${ID:-?}"
	say "VERSION         : ${VERSION:-?}"
	say "BASE            : ${BASE:-?} ${DEBIAN_RELEASE:-?} (${DEBIAN_CODENAME:-?})"
	say "PURPOSE         : ${PURPOSE:-?}"
	say "hostname        : $(cat /etc/hostname 2>/dev/null || echo '?')"
	say "profile tersedia: $(profile_names | tr '\n' ' ')"
}

# ---------------------------------------------------------------------------
# Profile
#
# Nama profile divalidasi dengan pola yang ketat, lalu dicocokkan ke file yang
# benar-benar ada di PROFILE_DIR. Tidak ada jalur di mana input user menjadi
# bagian dari perintah shell.
# ---------------------------------------------------------------------------
profile_names() {
	[ -d "$PROFILE_DIR" ] || return 0
	for f in "$PROFILE_DIR"/*.list; do
		[ -e "$f" ] || continue
		basename "$f" .list
	done
}

valid_name() {
	# Aturan tunggal, HARUS identik dengan scripts/gen-profile-list.sh:
	# huruf kecil, angka, tanda hubung, 1..32 karakter, tidak diawali '-'.
	#
	# Dulu ada pra-cek `case` di sini. Pra-cek itu tidak membatasi panjang,
	# sehingga nama 33+ karakter lolos pra-cek lalu ditolak regex — dua aturan
	# untuk satu hal, dan yang lebih longgar sempat menang. Dihapus; regex ini
	# satu-satunya sumber kebenaran. Tidak ada spasi di-strip: 'net working'
	# harus DITOLAK, bukan dirapikan menjadi 'networking'.
	printf '%s' "$1" | grep -Eq '^[a-z0-9][a-z0-9-]{0,31}$'
}

profile_path() {
	valid_name "$1" || die "nama profile tidak valid: '$1'
  Hanya huruf kecil, angka, dan tanda hubung. Contoh: networking"
	printf '%s/%s.list' "$PROFILE_DIR" "$1"
}

# ---------------------------------------------------------------------------
# Pembacaan package-list
#
# Aturan di sini HARUS identik dengan scripts/gen-profile-list.sh. Kalau
# berbeda, dua konsumen file profile yang sama akan menerima input berbeda —
# dan itu bug, bukan pilihan.
#
# Kesalahan yang pernah terjadi dan tidak boleh kembali:
#   - 's/[[:space:]]//g' menghapus spasi DI TENGAH, sehingga 'ip route2'
#     menjadi 'iproute2' dan ' bad name ' menjadi 'badname'. Salah tulis
#     jadi nama paket sah, tanpa peringatan.
#   - for x in $var memecah input pada spasi.
# Perbaikan: baca per baris, buang hanya spasi di ujung, validasi tiap entri.
# ---------------------------------------------------------------------------
PKG_RE='^[a-z0-9][a-z0-9+.-]*$'

# Baca file profile -> satu entri per baris di stdout.
# Komentar (#) dan baris kosong dibuang. Spasi di ujung dibuang.
profile_entries() {
	awk '{ sub(/#.*/, ""); gsub(/^[ 	]+|[ 	]+$/, ""); if (length) print }' "$1"
}

# Validasi seluruh isi profile. Mengembalikan non-zero dan mencetak entri
# pertama yang tidak valid ke stderr. Dipakai SEBELUM apt dipanggil.
profile_validate() {
	vf="$1"
	bad=""
	badline=0
	ln=0
	while IFS= read -r entry; do
		ln=$((ln + 1))
		[ -n "$entry" ] || continue
		if ! printf '%s' "$entry" | grep -Eq "$PKG_RE"; then
			bad="$entry"
			badline=$ln
			break
		fi
	done <<EOF
$(profile_entries "$vf")
EOF
	if [ -n "$bad" ]; then
		err "nama paket tidak valid di $vf (baris $badline): '$bad'"
		err "aturan: ^[a-z0-9][a-z0-9+.-]*$  (huruf kecil, angka, + . -)"
		return 1
	fi
	return 0
}

profile_packages() {
	# Entri sudah tervalidasi oleh pemanggil; keluaran tetap satu paket per baris.
	profile_entries "$1"
}

cmd_profile_list() {
	names="$(profile_names)"
	[ -n "$names" ] || { say "Tidak ada profile terpasang."; return 0; }
	printf '%-16s %-6s %s\n' "PROFILE" "PAKET" "KETERANGAN"
	for n in $names; do
		p="$PROFILE_DIR/$n.list"
		count="$(profile_packages "$p" | wc -l | tr -d ' ')"
		desc="$(sed -n 's/^#[[:space:]]*//p' "$p" | head -1)"
		printf '%-16s %-6s %s\n' "$n" "$count" "$desc"
	done
}

cmd_profile_check() {
	[ $# -eq 1 ] || die "pakai: oracle profile check NAME"
	p="$(profile_path "$1")"
	[ -f "$p" ] || die "profile '$1' tidak ada. Lihat: oracle profile list"
	# Ditolak di sini, bukan nanti saat apt gagal dengan pesan membingungkan.
	profile_validate "$p" || die "profile '$1' berisi nama paket tidak valid; tidak ada yang dipasang."
	say "Profile : $1"
	say "File    : $p"
	say "Paket   :"
	profile_packages "$p" | sed 's/^/  - /'
}

cmd_profile_install() {
	[ $# -eq 1 ] || die "pakai: oracle profile install NAME"

	if [ "$(id -u)" -ne 0 ]; then
		die "pemasangan profile butuh administrator.
  Jalankan: sudo oracle profile install $1"
	fi

	p="$(profile_path "$1")"
	[ -f "$p" ] || die "profile '$1' tidak ada. Lihat: oracle profile list"

	# Validasi SELURUH isi sebelum apt dipanggil. Tanpa ini, satu baris buruk
	# membuat apt menerima argumen asing dan gagal dengan pesan yang menyesatkan
	# — atau memasang sebagian.
	profile_validate "$p" || die "profile '$1' berisi nama paket tidak valid; tidak ada yang dipasang."

	pkgs="$(profile_packages "$p")"
	[ -n "$pkgs" ] || die "profile '$1' tidak berisi paket"

	say "Memasang profile '$1'..."
	# shellcheck disable=SC2086
	if ! DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends $pkgs; then
		die "apt-get gagal. Profile '$1' TIDAK terpasang penuh.
  Periksa output di atas, lalu jalankan ulang."
	fi
	say "Profile '$1' terpasang."
}

# ---------------------------------------------------------------------------
# Dispatch
# ---------------------------------------------------------------------------
[ $# -gt 0 ] || { usage; exit 1; }

cmd="$1"; shift

case "$cmd" in
	identity) cmd_identity ;;
	version)  [ -f "$CONF" ] || die "$CONF tidak ditemukan"; . "$CONF"; say "${NAME} ${VERSION}" ;;
	profile)
		[ $# -gt 0 ] || die "pakai: oracle profile {list|check|install} [NAME]"
		sub="$1"; shift
		case "$sub" in
			list)    cmd_profile_list ;;
			check)   cmd_profile_check "$@" ;;
			install) cmd_profile_install "$@" ;;
			*)       die "subperintah profile tidak dikenal: $sub (list|check|install)" ;;
		esac
		;;
	help|-h|--help) usage ;;
	*) die "perintah tidak dikenal: $cmd
  Coba: oracle help" ;;
esac