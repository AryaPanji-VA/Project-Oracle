<?xml version="1.0" encoding="UTF-8"?>
<!--
  ORACLE-OS — XFCE desktop (wallpaper) defaults
  Target: XFCE 4.20, Debian 13 Trixie
  Stage 3C. Lapisan default sistem: /etc/xdg.

  image-style=5 = zoomed. Wallpaper 1920x1200 diskalakan ke resolusi layar;
  varian 1280x800 tersedia di /usr/share/backgrounds/oracle/ untuk layar kecil
  dan dipilih manual lewat Settings > Desktop bila perlu.

  CATATAN PENTING — kunci monitor (Stage 3F):
  xfdesktop 4.20 menyimpan dan membaca backdrop di
    /backdrop/screen<N>/monitor<NAMA-OUTPUT>/workspace<N>/
  dengan <NAMA-OUTPUT> = nama output xrandr saat runtime ("Virtual-1" di QEMU,
  "eDP-1"/"HDMI-1" di hardware). Kunci statis "monitor0" di bawah TIDAK dipakai
  xfdesktop 4.20 untuk merender — terbukti di Stage 3D/3E: image-path benar dan
  berkas ada, tetapi desktop tetap memakai wallpaper bawaan.

  Karena nama output berbeda tiap mesin, wallpaper diterapkan oleh
  /usr/bin/oracle-wallpaper lewat /etc/xdg/autostart/oracle-wallpaper.desktop.
  Skrip itu membaca monitor yang benar-benar ada lalu mengisi kunci yang sesuai.
  Blok "monitor0" dipertahankan sebagai default generik untuk XFCE versi lain
  dan sebagai nilai cadangan bila autostart tidak berjalan.
-->
<channel name="xfce4-desktop" version="1.0">
  <property name="backdrop" type="empty">
    <property name="screen0" type="empty">
      <property name="monitor0" type="empty">
        <property name="workspace0" type="empty">
          <property name="last-image" type="string" value="/usr/share/backgrounds/oracle/workspace-1920x1200.png"/>
          <property name="image-path" type="string" value="/usr/share/backgrounds/oracle/workspace-1920x1200.png"/>
          <property name="image-style" type="int" value="5"/>
          <property name="color-style" type="int" value="0"/>
          <property name="rgba1" type="array">
            <value type="double" value="0.913725"/>
            <value type="double" value="0.898039"/>
            <value type="double" value="0.854902"/>
            <value type="double" value="1.000000"/>
          </property>
        </property>
      </property>
    </property>
  </property>
</channel>
